	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.21.0",
		"@types/node": "^26.2.0",
		"typescript": "^5.5.2",
		"vitest": "~4.1.0",
		"wrangler": "^4.124.0"
	}
}
